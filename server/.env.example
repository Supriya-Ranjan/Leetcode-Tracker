# Supabase → your project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# PORT=4000

# --- Password reset emails (optional locally) ---
# Without these, reset links are printed in the server log instead of emailed.
# Brevo → SMTP & API → API Keys → Generate a new API key.
# BREVO_API_KEY=xkeysib-...
# A sender address you've verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
# MAIL_FROM=you@gmail.com
# MAIL_FROM_NAME=LeetCode Tracker

# Where reset links point. Defaults to RENDER_EXTERNAL_URL on Render, else http://localhost:5173.
# APP_URL=https://your-app.onrender.com
